<tmpl_include name="inc.adminLayoutHeader.tmpl">
<form name="theForm" action="admin.php?op=updateTransferSettings" method="post" onsubmit="return validateSettings('transfer')">
<h1>transfer settings</h1>
<p class="NormalText">These settings control how TorrentFlux-NG talks to its torrent backend and the default limits applied to new transfers. This build uses <strong>qBittorrent</strong> (via its Web API) as the torrent client and <strong>wget</strong> for plain HTTP/FTP downloads.</p>
<p><input type="Submit" value="Update Settings"></p>

<h2>Access</h2>
<table id="adminTransferSettings">
	<tr>
		<th class="alt">Enable Torrent<br/><span>Who is allowed to add and manage torrent transfers. Torrents are handled by the qBittorrent backend configured below.</span></th>
		<td class="alt">
			<select name="enable_torrent" id="enable_torrent">
				<option value="0" <tmpl_if name="enable_torrent" value="0"> selected</tmpl_if>>Disabled &ndash; nobody</option>
				<option value="1" <tmpl_if name="enable_torrent" value="1"> selected</tmpl_if>>Admins only</option>
				<option value="2" <tmpl_if name="enable_torrent" value="2"> selected</tmpl_if>>All users</option>
			</select>
		</td>
	</tr>
	<tr>
		<th>Enable Wget<br /><span>Who is allowed to add plain HTTP/FTP downloads (direct file links, not torrents). Requires the <em>wget</em> binary, configured on the Server Settings page.</span></th>
		<td>
			<select name="enable_wget" id="enable_wget">
				<option value="0" <tmpl_if name="enable_wget" value="0"> selected</tmpl_if>>Disabled &ndash; nobody</option>
				<option value="1" <tmpl_if name="enable_wget" value="1"> selected</tmpl_if>>Admins only</option>
				<option value="2" <tmpl_if name="enable_wget" value="2"> selected</tmpl_if>>All users</option>
			</select>
		</td>
	</tr>
</table>

<h2>qBittorrent Backend</h2>
<p class="NormalText">TorrentFlux-NG does not run a torrent client itself &ndash; it drives a running <strong>qBittorrent</strong> (or <code>qbittorrent-nox</code>) instance through its Web API. Enable the Web UI in qBittorrent under <em>Tools &rarr; Options &rarr; Web UI</em>, then enter its address and credentials here. When TorrentFlux and qBittorrent run in the same Docker network, use the service name and internal port (for example <code>http://qbittorrent:8080</code>) rather than a public URL.</p>
<table id="adminTransferSettings">
	<tr>
		<th>qBittorrent<br /><span>Enable the qBittorrent Web API client. This must be on for torrents to work.</span></th>
		<td>
			<select name="qbittorrent_enable" id="qbittorrent_enable">
				<option value="0" <tmpl_if name="qbittorrent_enable" value="0"> selected</tmpl_if>>Disabled</option>
				<option value="1" <tmpl_if name="qbittorrent_enable" value="1"> selected</tmpl_if>>Enabled</option>
			</select>
		</td>
	</tr>
	<tr>
		<th class="alt">qBittorrent URL<br /><span>Base URL of the qBittorrent Web UI, including scheme and port, with no trailing path &ndash; e.g. <code>http://qbittorrent:8080</code> or <code>https://qbit.example.com</code>.</span></th>
		<td class="alt">
			<input name="qbittorrent_url" id="qbittorrent_url" type="Text" maxlength="254" value="<tmpl_var name="qbittorrent_url">" size="45">
		</td>
	</tr>
	<tr>
		<th>qBittorrent User<br /><span>Web UI username (qBittorrent default is <code>admin</code>).</span></th>
		<td>
			<input name="qbittorrent_user" id="qbittorrent_user" type="Text" maxlength="60" value="<tmpl_var name="qbittorrent_user">" size="20">
		</td>
	</tr>
	<tr>
		<th class="alt">qBittorrent Password<br /><span>Web UI password. Stored so TorrentFlux can authenticate to the API; use a dedicated account if you can.</span></th>
		<td class="alt">
			<input name="qbittorrent_pass" id="qbittorrent_pass" type="Password" maxlength="100" value="<tmpl_var name="qbittorrent_pass">" size="20">
		</td>
	</tr>
</table>

<h2>Default Transfer Limits</h2>
<p class="NormalText">Defaults applied to each new torrent when it is added. They are pushed to qBittorrent per-transfer, and users can override them per-torrent (if allowed on the Control Settings page). Existing transfers are not changed retroactively.</p>
<table id="adminTransferSettings">
	<tr>
		<th class="alt">Default Max Upload Rate<br /><span>Upload speed cap applied to each new transfer. Set <code>0</code> for unlimited.</span></th>
		<td class="alt">
			<input name="max_upload_rate" id="max_upload_rate" type="Text" maxlength="6" value="<tmpl_var name="max_upload_rate">" size="6"> kB/s <span class="NormalText">(0 = unlimited)</span>
		</td>
	</tr>
	<tr>
		<th>Default Max Download Rate<br /><span>Download speed cap applied to each new transfer. Set <code>0</code> for unlimited.</span></th>
		<td>
			<input name="max_download_rate" id="max_download_rate" type="Text" maxlength="6" value="<tmpl_var name="max_download_rate">" size="6"> kB/s <span class="NormalText">(0 = unlimited)</span>
		</td>
	</tr>
	<tr>
		<th class="alt">Default Seeding Behaviour<br /><span>Whether new torrents keep seeding after they finish downloading. Please leave seeding enabled and use the ratio limit below to decide when to stop.</span></th>
		<td class="alt">
			<select name="die_when_done" id="die_when_done">
				<option value="False" <tmpl_if name="die_when_done" value="False">selected</tmpl_if>>Keep seeding when complete</option>
				<option value="True" <tmpl_if name="die_when_done" value="True">selected</tmpl_if>>Stop when complete</option>
			</select>
		</td>
	</tr>
	<tr>
		<th>
			Seed Ratio Limit<br /><span>Stop seeding once a torrent reaches this share ratio, expressed as a percentage: <code>100</code> = 1:1 (uploaded as much as downloaded), <code>200</code> = 2:1. Set <code>0</code> to seed indefinitely. Enforced through qBittorrent's seed-ratio limit.</span>
		</th>
		<td>
			<input name="sharekill" id="sharekill" type="Text" maxlength="5" value="<tmpl_var name="sharekill">" size="5"> % <span class="NormalText">(0 = seed forever)</span>
		</td>
	</tr>
	<tr>
		<th class="alt">Enable File Priority<br /><span>Let users pick which files inside a multi-file torrent to download (skip / normal / high) from the transfer's Files tab. Priorities are sent to qBittorrent.</span></th>
		<td class="alt">
			<select name="enable_file_priority" id="enable_file_priority">
				<option value="1" <tmpl_if name="enable_file_priority" value="1">selected</tmpl_if>>Enabled</option>
				<option value="0" <tmpl_if name="enable_file_priority" value="0">selected</tmpl_if>>Disabled</option>
			</select>
		</td>
	</tr>
</table>

<h2>Wget (HTTP / FTP downloads)</h2>
<p class="NormalText">Options for the non-torrent download path, used when a user pastes a direct <code>http://</code>, <code>https://</code> or <code>ftp://</code> file link. Access is controlled by <em>Enable Wget</em> above.</p>
<table id="adminTransferSettings">
	<tr>
		<th class="alt">Default Download Rate Limit<br /><span>Speed cap for each wget download. Set <code>0</code> for unlimited.</span></th>
		<td class="alt">
			<input name="wget_limit_rate" id="wget_limit_rate" type="Text" maxlength="6" value="<tmpl_var name="wget_limit_rate">" size="6"> kB/s <span class="NormalText">(0 = unlimited)</span>
		</td>
	</tr>
	<tr>
		<th>Retry Limit<br /><span>How many times wget retries a failed download before giving up. Set <code>0</code> for unlimited retries.</span></th>
		<td>
			<input name="wget_limit_retries" id="wget_limit_retries" type="Text" maxlength="5" value="<tmpl_var name="wget_limit_retries">" size="5"> <span class="NormalText">(0 = unlimited)</span>
		</td>
	</tr>
	<tr>
		<th class="alt">Passive FTP<br /><span>Use passive mode for FTP transfers. Usually required when the server is behind a firewall or NAT.</span></th>
		<td class="alt">
			<select name="wget_ftp_pasv" id="wget_ftp_pasv">
				<option value="1" <tmpl_if name="wget_ftp_pasv" value="1">selected</tmpl_if>>Enabled</option>
				<option value="0" <tmpl_if name="wget_ftp_pasv" value="0">selected</tmpl_if>>Disabled</option>
			</select>
		</td>
	</tr>
</table>

<p><input type="Submit" value="Update Settings"></p>
</form>
<tmpl_include name="inc.adminLayoutFooter.tmpl">
